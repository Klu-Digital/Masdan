{
  "name": "k22i",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:infra && mprocs",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types && tsc --noEmit -p scripts/tsconfig.json",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "rename": "tsx scripts/rename-project.ts",
    "secrets:setup": "pnpm --filter server exec tsx ../../scripts/secrets/setup.ts",
    "secrets:check": "pnpm --filter server exec tsx ../../scripts/secrets/check.ts",
    "staged": "vp staged",
    "dev:infra": "docker compose up -d --wait postgres redis minio && docker compose run --rm minio-init",
    "dev:native": "vp run --filter native dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "pnpm dev:infra && vp run --filter server dev",
    "dev:workers": "pnpm dev:infra && vp run --filter workers dev",
    "dev:down": "lsof -ti tcp:${WEB_PORT:-2600},${SERVER_PORT:-1900},${NATIVE_PORT:-8081} | xargs kill -9 2>/dev/null; true",
    "dev:down-all": "pnpm dev:down; docker compose stop postgres redis minio",
    "db:push": "vp run --filter @k22i/db db:push",
    "db:studio": "vp run --filter @k22i/db db:studio",
    "db:generate": "vp run --filter @k22i/db db:generate",
    "db:migrate": "vp run --filter @k22i/db db:migrate",
    "db:deploy": "vp run --filter @k22i/db db:migrate && vp run --filter @k22i/queue queue:migrate && vp run --filter @k22i/db post-migrate:run",
    "db:post-migrate": "vp run --filter @k22i/db post-migrate",
    "db:post-migrate:new": "vp run --filter @k22i/db post-migrate:new",
    "db:post-migrate:status": "vp run --filter @k22i/db post-migrate:status",
    "db:purge": "vp run --filter @k22i/db purge",
    "admin:grant": "vp run --filter @k22i/db grant-admin",
    "queue:migrate": "vp run --filter @k22i/queue queue:migrate",
    "db:seed": "vp run --filter @k22i/db seed",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "redis:start": "docker compose up -d redis",
    "redis:watch": "docker compose up redis",
    "redis:stop": "docker compose stop redis",
    "redis:down": "docker compose down redis",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:db": "vp test run --project db",
    "test:web": "vp test run --project web",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@k22i/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@k22i/config": "workspace:*",
    "@k22i/testing": "workspace:*",
    "@shadcn/lint": "^0.1.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "catalog:",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "mprocs": "^0.9.6",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rolldown": "1.2.6",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.3",
    "ultracite": "^7.11.0",
    "vite-plus": "0.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.2"
}
