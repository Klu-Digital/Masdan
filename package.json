{
  "name": "masdan",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:infra && mprocs",
    "build": "vp run -r build",
    "check-types": "vp run -r --parallel check-types && tsc --noEmit -p scripts/tsconfig.json",
    "check": "ultracite check",
    "knip": "knip --dependencies",
    "fix": "ultracite fix",
    "lint": "vp lint",
    "format": "vp fmt",
    "rename": "node scripts/rename-project.ts",
    "secrets:setup": "pnpm --filter server exec tsx ../../scripts/secrets/setup.ts",
    "secrets:check": "pnpm --filter server exec tsx ../../scripts/secrets/check.ts",
    "telegram:webhook": "pnpm --filter server exec tsx ../../scripts/telegram/webhook.ts",
    "staged": "vp staged",
    "dev:infra": "docker compose up -d --wait postgres redis minio && docker compose run --rm minio-init",
    "dev:native": "vp run --filter native dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "pnpm dev:infra && vp run --filter server dev",
    "dev:workers": "pnpm dev:infra && vp run --filter workers dev",
    "dev:down": "lsof -ti tcp:${WEB_PORT:-2600},${SERVER_PORT:-1900},${NATIVE_PORT:-8081} | xargs kill -9 2>/dev/null; true",
    "dev:down-all": "pnpm dev:down; docker compose stop postgres redis minio",
    "db:push": "vp run --filter @masdan/db db:push",
    "db:studio": "vp run --filter @masdan/db db:studio",
    "db:generate": "vp run --filter @masdan/db db:generate",
    "db:migrate": "vp run --filter @masdan/db db:migrate",
    "db:deploy": "vp run --filter @masdan/db db:migrate && vp run --filter @masdan/queue queue:migrate && vp run --filter @masdan/db post-migrate:run",
    "db:post-migrate": "vp run --filter @masdan/db post-migrate",
    "db:post-migrate:new": "vp run --filter @masdan/db post-migrate:new",
    "db:post-migrate:status": "vp run --filter @masdan/db post-migrate:status",
    "db:purge": "vp run --filter @masdan/db purge",
    "db:reset": "pnpm run db:purge --yes && pnpm run db:push && pnpm run db:post-migrate && pnpm run db:seed",
    "admin:grant": "vp run --filter @masdan/db grant-admin",
    "admin:reset-password": "vp run --filter @masdan/db reset-password",
    "queue:migrate": "vp run --filter @masdan/queue queue:migrate",
    "db:seed": "vp run --filter @masdan/db seed",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "redis:start": "docker compose up -d redis",
    "redis:watch": "docker compose up redis",
    "redis:stop": "docker compose stop redis",
    "redis:down": "docker compose down redis",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:db": "vp test run --project db",
    "test:web": "vp test run --project web",
    "test:watch": "vp test watch"
  },
  "devDependencies": {
    "@masdan/config": "workspace:*",
    "@masdan/testing": "workspace:*",
    "@shadcn/lint": "^0.1.0",
    "@types/node": "catalog:",
    "jsdom": "^30.0.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.12",
    "mprocs": "^0.9.6",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rolldown": "1.2.6",
    "typescript": "catalog:",
    "ultracite": "^7.11.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@10.33.2"
}
