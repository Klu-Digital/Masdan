---
import {
  AiMagicIcon,
  CloudServerIcon,
  Database01Icon,
  FlashIcon,
  TelegramIcon,
} from "@hugeicons/core-free-icons";
import { PUBLISHED_IMAGES, REPO, SELF_HOSTING } from "../lib/links";
import Boundary from "./boundary.astro";
import Icon from "./icon.astro";

const commands = [
  `git clone ${REPO}.git && cd Masdan`,
  "pnpm install && pnpm secrets:setup",
  "docker compose up -d --wait postgres && pnpm db:deploy",
  "pnpm docker:up",
];

const optional = [
  { icon: FlashIcon, name: "Redis", use: "Cache and shared rate limits. Without it, both fall back to each process." },
  { icon: CloudServerIcon, name: "S3 storage", use: "Receipts and attachments, on any S3-compatible bucket." },
  { icon: AiMagicIcon, name: "AI provider", use: "Quick entry, receipts, categorization and Ask Masdan, capped daily per household and per person." },
  { icon: TelegramIcon, name: "Telegram", use: "Chat entry from your phone." },
];
---

<section id="self-host" class="mt-20 border-t border-rule md:mt-28" aria-labelledby="self-host-title">
  <Boundary mark="§5" />
  <div class="sheet">
    <div class="col-span-4 px-4 pt-14 pb-10 md:col-span-8 md:px-6 md:pt-20 md:pb-14">
      <h2 id="self-host-title" class="text-4xl leading-none font-bold tracking-[-0.03em] text-balance md:text-6xl">
        Your server. Your Postgres.
      </h2>
      <p class="mt-5 max-w-[52ch] text-base leading-relaxed text-muted md:text-lg">
        Four commands from a clone to a running household, on one machine with Docker. Or skip the
        clone and run the <a href={PUBLISHED_IMAGES} class="font-semibold text-brand-text underline underline-offset-4">published images</a>.
      </p>
      <a href={SELF_HOSTING} class="mt-4 inline-block font-semibold text-brand-text underline underline-offset-4">Read the self-hosting guide</a>
    </div>
    <div class="cell-surface col-span-4 md:col-span-7">
      <p class="label flex justify-between border-b border-rule px-4 py-3 md:px-6">
        <span>shell</span><span>~/Masdan</span>
      </p>
      <pre
        class="figures overflow-x-auto px-4 py-6 text-[0.8125rem] leading-7 md:px-6 md:py-8 md:text-sm"
        tabindex="0"
        aria-label="Commands to run Masdan"><code>{commands.map((command) => (
          <span class="block"><span class="text-brand-text select-none" aria-hidden="true">$ </span>{command}</span>
        ))}<span class="mt-4 block text-muted"># then open http://localhost:2600</span><span class="block text-muted"># the first account you create becomes the admin</span></code></pre>
    </div>
    <dl class="col-span-4 md:col-span-5">
      <div class="cell border-b border-hairline px-4 py-6 md:px-6">
        <dt class="label">Required</dt>
        <dd class="mt-3 flex gap-3">
          <Icon icon={Database01Icon} class="mt-0.5 size-5 text-brand" />
          <span>
            <span class="text-lg font-semibold tracking-tight">Postgres</span>
            <span class="mt-1 block leading-relaxed text-muted">
              The system of record: the ledger, sessions and the job queue.
            </span>
          </span>
        </dd>
      </div>
      <div class="cell px-4 py-6 md:px-6">
        <dt class="label">Optional</dt>
        {
          optional.map((item) => (
            <dd class="mt-3 grid grid-cols-[1.25rem_6.5rem_1fr] gap-3 text-[0.9375rem] leading-relaxed">
              <Icon icon={item.icon} class="mt-0.5 text-brand" />
              <span class="font-semibold">{item.name}</span>
              <span class="text-muted">{item.use}</span>
            </dd>
          ))
        }
      </div>
    </dl>
  </div>
</section>
