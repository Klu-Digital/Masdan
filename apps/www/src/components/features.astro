---
import Boundary from "./boundary.astro";

const features = [
  {
    body: "Income, expenses and transfers with splits, tags, attachments and recurring schedules. CSV in, CSV out.",
    coordinate: "A1",
    glyph: "ledger",
    span: "md:col-span-7",
    title: "Ledger",
  },
  {
    body: "Assets and liabilities in any currency. Beautifully designed credit cards, with statements and net-worth history.",
    coordinate: "A8",
    glyph: "accounts",
    span: "md:col-span-5",
    title: "Accounts",
  },
  {
    body: "Category budgets, savings goals, card reminders and a bill calendar any calendar app can subscribe to.",
    coordinate: "B1",
    glyph: "planning",
    span: "md:col-span-4",
    title: "Planning",
  },
  {
    body: "Cash flow, category spending, savings rate and budget performance, all read from the ledger.",
    coordinate: "B5",
    glyph: "reports",
    span: "md:col-span-3",
    title: "Reports",
  },
  {
    body: "Optional. Quick entry from free text, receipt photos or Telegram, AI categorization and Ask Masdan. Every AI call is capped per household.",
    coordinate: "B8",
    glyph: "assistance",
    span: "md:col-span-5",
    title: "Assistance",
  },
] as const;
---

<section id="features" class="mt-20 border-t border-rule md:mt-28" aria-labelledby="features-title">
  <Boundary mark="§1" />
  <div class="sheet">
    <div class="col-span-4 px-4 pt-14 pb-10 md:col-span-8 md:px-6 md:pt-20 md:pb-14">
      <h2 id="features-title" class="text-4xl leading-none font-bold tracking-[-0.03em] text-balance md:text-6xl">
        Built around one shared ledger.
      </h2>
      <p class="mt-5 max-w-[56ch] text-base leading-relaxed text-muted md:text-lg">
        Every member of the household records into the same books. Balances, budgets and
        reports are derived from it, never typed in twice.
      </p>
    </div>
    {
      features.map((feature) => (
        <article class:list={["relative col-span-4 border-t border-rule px-4 pt-6 pb-8 md:px-6 md:pt-8 md:pb-10", feature.span, feature.glyph === "assistance" ? "bg-surface shadow-[inset_1px_0_0_var(--rule)]" : "cell"]}>
          <span class="label absolute top-3 right-3" aria-hidden="true">{feature.coordinate}</span>
          <canvas class="glyph" data-glyph={feature.glyph} aria-hidden="true" />
          <h3 class="mt-8 text-xl font-semibold tracking-tight md:text-2xl">{feature.title}</h3>
          <p class="mt-2 max-w-[44ch] leading-relaxed text-muted">{feature.body}</p>
        </article>
      ))
    }
    <article class="cell-brand relative col-span-4 grid gap-6 px-4 py-8 md:col-span-12 md:grid-cols-12 md:px-0 md:py-10">
      <span class="label absolute top-3 right-3 text-white" aria-hidden="true">C1</span>
      <div class="md:col-span-3 md:px-6">
        <canvas class="glyph" data-glyph="selfhost" aria-hidden="true"></canvas>
      </div>
      <div class="md:col-span-6 md:px-6">
        <h3 class="text-xl font-semibold tracking-tight md:text-2xl">Self-hosted</h3>
        <p class="mt-2 max-w-[52ch] leading-relaxed text-white">
          Postgres is the system of record. Redis and S3-compatible storage are optional, and
          the whole stack runs from one Docker Compose file.
        </p>
      </div>
      <div class="flex items-end md:col-span-3 md:justify-end md:px-6">
        <a href="#self-host" class="font-semibold underline underline-offset-4">How to run it</a>
      </div>
    </article>
  </div>
</section>
