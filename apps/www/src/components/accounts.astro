---
import Boundary from "./boundary.astro";

const facts = [
  {
    body: "Pick the card from a catalog of real designs, grouped by country. The list shows the card you carry, not a grey rectangle.",
    span: "md:col-span-5",
    title: "Real card looks",
  },
  {
    body: "Each statement keeps its period, balance, minimum due and due date, and puts the payment on the bill calendar.",
    span: "md:col-span-4",
    title: "Statements",
  },
  {
    body: "Every account keeps its own currency. Net worth converts them into the household's.",
    span: "md:col-span-3",
    title: "Currencies",
  },
] as const;
---

<section id="accounts" aria-labelledby="accounts-title">
  <Boundary mark="§3" />
  <div class="sheet">
    <div class="col-span-4 px-4 pt-14 pb-10 md:col-span-8 md:col-start-5 md:px-6 md:pt-20 md:pb-14">
      <h2 id="accounts-title" class="text-4xl leading-none font-bold tracking-[-0.03em] text-balance md:text-6xl">
        Cards that look like your cards.
      </h2>
      <p class="mt-5 max-w-[52ch] text-base leading-relaxed text-muted md:text-lg">
        Assets on one side, liabilities on the other, and the balance sheet that falls out of
        them, month after month.
      </p>
    </div>
    <figure class="col-span-4 m-0 md:col-span-12">
      <div class="-mx-px border-y border-rule bg-paper px-px">
        <canvas class="art aspect-[4/3] md:aspect-[3/1]" data-art="cards" aria-hidden="true"></canvas>
      </div>
      <figcaption class="label flex gap-3 border-b border-hairline py-3 leading-snug">
        <span class="shrink-0">fig. 4</span>
        <span>Cards, each drawn as a card rather than a row in a table.</span>
      </figcaption>
    </figure>
    {
      facts.map((fact) => (
        <div class:list={["cell col-span-4 border-b border-hairline px-4 pt-6 pb-8 md:px-6 md:pb-10", fact.span]}>
          <h3 class="text-lg font-semibold tracking-tight">{fact.title}</h3>
          <p class="mt-1.5 max-w-[46ch] leading-relaxed text-muted">{fact.body}</p>
        </div>
      ))
    }
  </div>
</section>
