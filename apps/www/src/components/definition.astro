---
import Boundary from "./boundary.astro";
---

<section id="masdan" class="mt-20 border-t border-rule md:mt-28" aria-labelledby="masdan-title">
  <Boundary mark="§0" />
  <div class="sheet">
    <div class="col-span-4 px-4 pt-14 pb-10 md:col-span-5 md:px-6 md:pt-20 md:pb-16">
      <h2 id="masdan-title" lang="tl" class="text-6xl leading-none font-bold tracking-[-0.04em] text-brand md:text-8xl">
        masdan
      </h2>
      <p class="label mt-5">Tagalog, verb. From <span lang="tl">masid</span>, careful observation.</p>
      <ol class="mt-8 space-y-3 text-lg leading-snug">
        <li class="flex gap-4"><span class="figures text-brand-text">1</span>To observe closely.</li>
        <li class="flex gap-4"><span class="figures text-brand-text">2</span>To look at something carefully, with full attention.</li>
      </ol>
    </div>
    <div class="cell col-span-4 px-4 pt-6 pb-14 md:col-span-7 md:px-10 md:pt-20 md:pb-16">
      <p class="text-3xl leading-[1.1] font-bold tracking-[-0.03em] text-balance md:text-5xl">
        Look closely at all of it.
      </p>
      <p class="mt-6 max-w-[54ch] text-base leading-relaxed text-muted md:text-lg">
        Bank apps, card statements, a spreadsheet, a drawer of receipts. Masdan puts every account,
        card, bill, budget and goal into one ledger the household shares, so the whole picture is one
        screen away.
      </p>
    </div>
  </div>
</section>
