---
import Boundary from "./boundary.astro";

const callouts = [
  {
    at: "top-[9%]",
    body: "Bring in a bank's CSV export. Rows already imported are skipped, so a re-run never doubles the books.",
    letter: "A",
    title: "CSV import",
  },
  {
    at: "top-[40%]",
    body: "A schedule posts the rent, the gym or the card payment on a daily, weekly or monthly rhythm.",
    letter: "B",
    title: "Recurring",
  },
  {
    at: "top-[70%]",
    body: "Split one receipt across categories. Tags sit beside categories, so “Family” can cut across all of them.",
    letter: "C",
    title: "Splits and tags",
  },
] as const;
---

<section id="ledger" class="mt-20 border-t border-rule md:mt-28" aria-labelledby="ledger-title">
  <Boundary mark="§2" />
  <div class="sheet">
    <div class="col-span-4 px-4 pt-14 pb-10 md:col-span-7 md:px-6 md:pt-20 md:pb-14">
      <h2 id="ledger-title" class="text-4xl leading-none font-bold tracking-[-0.03em] text-balance md:text-6xl">
        Every movement, written once.
      </h2>
      <p class="mt-5 max-w-[52ch] text-base leading-relaxed text-muted md:text-lg">
        Income, expenses and transfers land in one ordered ledger, on the household's own
        calendar day.
      </p>
    </div>
    <figure class="col-span-4 m-0 md:col-span-12 lg:col-span-8">
      <div class="border-y border-r border-rule bg-paper">
        <canvas class="art aspect-[4/3]" data-art="ledger" aria-hidden="true"></canvas>
      </div>
      <figcaption class="label flex gap-3 border-b border-hairline py-3 leading-snug">
        <span class="shrink-0">fig. 3</span>
        <span>The ledger as it fills: income in green, transfers in blue, spending in ink.</span>
      </figcaption>
    </figure>
    <ol class="col-span-4 grid md:col-span-12 md:grid-cols-12 lg:relative lg:col-span-4 lg:block">
      {
        callouts.map((callout) => (
          <li class:list={["cell border-b border-hairline px-4 py-6 md:col-span-4 md:px-6 lg:absolute lg:inset-x-0 lg:border-b-0 lg:shadow-none lg:py-0 lg:pl-10", callout.at]}>
            <span class="absolute top-2.5 left-0 hidden h-px w-7 bg-ink lg:block" aria-hidden="true" />
            <span class="cross top-2.5 left-0 hidden lg:block" aria-hidden="true" />
            <p class="label">{callout.letter}</p>
            <h3 class="mt-2 text-lg font-semibold tracking-tight">{callout.title}</h3>
            <p class="mt-1.5 max-w-[34ch] text-[0.9375rem] leading-relaxed text-muted">{callout.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
