---
import { ArrowRight01Icon, Github01Icon } from "@hugeicons/core-free-icons";
import { GETTING_STARTED, REPO } from "../lib/links";
import Icon from "./icon.astro";
---

<section data-lamp aria-labelledby="hero-title">
    <div class="relative border-b border-rule">
        <canvas
            class="dither absolute inset-0"
            data-dither="hero"
            aria-hidden="true"
        ></canvas>
        <div class="rules" aria-hidden="true"></div>
        <div class="sheet pt-12 pb-16 md:pt-20 md:pb-24">
            <div data-depth="0.1" class="cell-solid relative col-span-4 flex flex-col justify-center px-5 py-10 md:col-span-7 md:p-10 lg:p-14">
                <span class="label absolute top-3 right-3" aria-hidden="true">
                    A1
                </span>
                <h1
                    id="hero-title"
                    class="text-[2.25rem] leading-[1.02] font-bold tracking-[-0.035em] text-balance md:text-5xl lg:text-[3.75rem]"
                >
                    Look closely at your money: where it is, and where it went.
                </h1>
                <p class="mt-5 max-w-[44ch] text-base leading-relaxed text-muted md:mt-6 md:text-lg">
                    Every account, card, bill and budget in one shared ledger,
                    on a server you own.
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href={GETTING_STARTED} class="btn btn-primary">
                        Self-host it
                        <Icon icon={ArrowRight01Icon} />
                    </a>
                    <a href={REPO} class="btn btn-ghost">
                        <Icon icon={Github01Icon} />
                        View on GitHub
                    </a>
                </div>
            </div>
            <figure data-depth="0.1" class="cell-solid relative col-span-4 m-0 mt-6 md:col-span-5 md:mt-0">
                <span class="label absolute top-3 right-3" aria-hidden="true">
                    A8
                </span>
                <canvas
                    class="art aspect-square"
                    data-art="iris"
                    aria-hidden="true"
                ></canvas>
                <figcaption class="label flex gap-3 border-hairline px-4 py-3 leading-snug">
                    <span class="shrink-0">fig. 1</span>
                    <span>
                        The household, observed: the outer ring is where the
                        month's money went.
                    </span>
                </figcaption>
            </figure>
        </div>
    </div>
</section>
