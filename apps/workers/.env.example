# Workers use shared backend configuration, but do not authenticate users.
SERVICE_NAME=masdan-workers

DATABASE_URL=postgresql://postgres:password@localhost:4400/masdan

# Worker health + metrics server.
WORKERS_PORT=1901
WORKERS_CONCURRENCY=1
WORKERS_POLLING_INTERVAL_SECONDS=2

# Queue settings. Defaults are suitable for local development.
# QUEUE_LISTEN_NOTIFY=true
# PGBOSS_SCHEMA=pgboss
# QUEUE_POOL_MAX=10

# Metrics are exposed only when both are set. `pnpm secrets:setup` creates a
# token without printing it; leave the path commented to keep metrics disabled.
# PROMETHEUS_METRICS_PATH=/metrics
# PROMETHEUS_METRICS_TOKEN=

# Optional shared integrations.
# REDIS_URL=redis://localhost:6666
# REDIS_KEY_PREFIX=masdan:dev:
# POSTHOG_PROJECT_API_KEY=phc_your-project-api-key
# POSTHOG_HOST=https://eu.i.posthog.com
