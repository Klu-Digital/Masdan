# Workers use shared backend configuration, but do not authenticate users.
SERVICE_NAME=masdan-workers

DATABASE_URL=postgresql://postgres:password@localhost:4400/masdan

# Worker health + metrics server.
WORKERS_PORT=1901
WORKERS_CONCURRENCY=1
WORKERS_POLLING_INTERVAL_SECONDS=2

# FX_RATES_URL=https://api.frankfurter.dev/v1/latest?base=EUR

# Queue settings. Defaults are suitable for local development.
# QUEUE_LISTEN_NOTIFY=true
# PGBOSS_SCHEMA=pgboss
# QUEUE_POOL_MAX=10

# Metrics are exposed only when both are set. `pnpm secrets:setup` creates a
# token without printing it; leave the path commented to keep metrics disabled.
# PROMETHEUS_METRICS_PATH=/metrics
# PROMETHEUS_METRICS_TOKEN=

# Object storage. Import jobs read uploaded CSVs from the bucket, so these must
# match apps/server/.env. Unset, import jobs fail with a storage error.
# S3_BUCKET=masdan
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_ENDPOINT=http://localhost:5300
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_ENDPOINT=http://localhost:5300
# STORAGE_MAX_UPLOAD_BYTES=26214400

# AI, for chat entry's quick-entry parse. Same values as apps/server/.env;
# see the AI section there. Unset, chat messages are never created.
# CLOUDFLARE_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_id>/compat
# CLOUDFLARE_AI_GATEWAY_TOKEN=
# AI_PROVIDER_API_KEY=
# QUICK_TRANSACTION_AI_MODEL=openai/gpt-4.1-mini
# RECEIPT_AI_MODEL=openai/gpt-4.1-mini
# ASK_MASDAN_AI_MODEL=openai/gpt-4.1-mini
# CATEGORIZE_AI_MODEL=openai/gpt-4.1-mini

# Chat entry replies. Webhook secrets stay in apps/server/.env.
# CHAT_APP_URL=http://localhost:2600
# TELEGRAM_BOT_TOKEN=

# Optional shared integrations.
# REDIS_URL=redis://localhost:6666
# REDIS_KEY_PREFIX=masdan:dev:
# POSTHOG_PROJECT_API_KEY=phc_your-project-api-key
# POSTHOG_HOST=https://eu.i.posthog.com
