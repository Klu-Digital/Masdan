# Copy to `.env`. Expo exposes only `EXPO_PUBLIC_`-prefixed variables to app code
# and inlines them at bundle time, so a change needs a bundler restart. Nothing
# here is a secret: it ships inside the app binary.

# Where the app sends every API call.
#
# `localhost` works for the iOS simulator and for Expo Go on the web. It does not
# work from a physical device or the Android emulator, which resolve `localhost`
# to themselves — use the LAN IP your dev machine is reachable at (Expo prints it
# on startup), e.g. http://192.168.1.20:1900, and add that origin to the server's
# CORS_ORIGIN.
EXPO_PUBLIC_SERVER_URL=http://localhost:1900
